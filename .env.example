# ==============================================================================
# MentorHub AI - Environment Configuration Example
# Copy this file to .env in the server folder or set in your production environment
# ==============================================================================

# Database
# If left blank, MentorHub AI automatically spins up an in-memory MongoDB instance
# with full persistence for zero-config local evaluation & testing.
MONGODB_URI=

# Port & Server Settings
SERVER_PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Authentication Secrets
JWT_SECRET=mentorhub-ai-jwt-super-secret-key-2026
JWT_REFRESH_SECRET=mentorhub-ai-jwt-refresh-super-secret-key-2026

# Google Gemini AI API Key
# If left empty, MentorHub AI automatically runs in resilient intelligent academic fallback mode
GEMINI_API_KEY=your_gemini_api_key_here

# Cloud Document Storage (Optional Cloudinary Configuration)
# If left empty, documents are saved to the server/uploads local directory with safe filename isolation
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
